# VorynOS: curated source archives built with git archive.
# GitHub-generated Source code downloads may ignore export-ignore.

# AI development instructions are not part of source distributions.
# The root AGENTS.md is the canonical protocol discovered by agents.
/internal/ export-ignore
/AGENTS.md export-ignore

# Repository automation and administrative documentation.
/.github/ export-ignore
/CONTRIBUTING.md export-ignore
/SECURITY.md export-ignore

# Brand assets are not needed to compile the operating system.
/assets/branding/ export-ignore

# Source packaging script is not needed inside its own output.
/scripts/package-source.sh export-ignore
