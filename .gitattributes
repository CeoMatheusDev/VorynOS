# VorynOS: exclusions for archives generated by git archive.
# These rules do not guarantee exclusions from GitHub's automatic Source code ZIP.

# Internal development prompts and instructions (kept in Git history).
/INSTRUÇÕES* export-ignore
/PROMPT* export-ignore

# GitHub administration and contributor-only material.
/.github/ export-ignore
/AGENTS.md export-ignore

# Keep the archive-generation script out of the source distribution.
/scripts/package-source.sh export-ignore
